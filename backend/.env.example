PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hugatiera_db

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Optional AI assistant provider. API keys are never exposed to the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
AI_HOURLY_LIMIT=10

# Optional PayMongo Checkout API key (sk_test_... or sk_live_...).
# When left blank, HugaTiera automatically runs in built-in Sandbox/Demo Checkout Mode.
PAYMONGO_SECRET_KEY=
FRONTEND_URL=http://localhost:5173
