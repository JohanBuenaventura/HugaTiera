PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hugatiera_db

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Optional AI assistant provider. API keys are never exposed to the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
AI_HOURLY_LIMIT=10

# Optional Cloudflare Workers AI photo concept editing (free tier: 10,000 Neurons/day).
# Keep AI_IMAGE_GEN_ENABLED=false unless explicitly enabled for testing/demo.
AI_IMAGE_GEN_ENABLED=false
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_TO_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
AI_IMAGE_DAILY_LIMIT=3

# Optional PayMongo Checkout API key (sk_test_... or sk_live_...).
# When left blank, HugaTiera automatically runs in built-in Sandbox/Demo Checkout Mode.
PAYMONGO_SECRET_KEY=
FRONTEND_URL=http://localhost:5173
