PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hugatiera_db

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Optional AI assistant provider. API keys are never exposed to the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
AI_HOURLY_LIMIT=10
AI_IMAGE_GENERATION_ENABLED=false
AI_IMAGE_PROVIDER=comfyui
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
AI_IMAGE_GENERATION_TIMEOUT_MS=90000
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_JSON=
COMFYUI_TIMEOUT_MS=120000
AI_IMAGE_COOLDOWN_SECONDS=60
