PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hugatiera_db

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173

# Password reset email delivery. SMTP is optional for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HugaTiera <no-reply@hugatiera.local>
PASSWORD_RESET_TTL_MINUTES=30

# Optional AI assistant provider. API keys are never exposed to the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
AI_HOURLY_LIMIT=10
